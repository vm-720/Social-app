# Postgres connection string (Supabase or any Postgres). Leave empty to use a
# local embedded Postgres (PGlite) stored in ./.data, which is fine for development.
DATABASE_URL=

# Claude API key, used to score comments.
ANTHROPIC_API_KEY=
# Model used for scoring. Defaults to claude-opus-5-5. claude-haiku-5-5 is far cheaper.
ANALYSIS_MODEL=claude-opus-5-5

# Meta Graph API version used by the Facebook and Instagram connectors.
META_GRAPH_VERSION=v23.0

# Shared secret the hourly cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Supabase project (Project Settings -> API). Without these, local development runs signed in
# as a single dev user; production refuses to serve until they are set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 32 random bytes, base64, used to encrypt platform access tokens at rest:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
